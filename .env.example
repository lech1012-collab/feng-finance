# Optional owner-managed feedback configuration. Never put private data here.
# A Microsoft Forms "Get a pre-filled link" URL can include its existing public id.
VITE_FEEDBACK_URL=
# Actual Forms question parameter, e.g. the r... key from its pre-filled link.
# With no parameter, Feng copies technical context for the tester to paste.
VITE_FEEDBACK_CONTEXT_PARAMETER=
# Used when no valid HTTPS form address is available.
VITE_FEEDBACK_EMAIL=
# GitHub Pages /feng-finance/; custom-domain hosting uses /.
VITE_BASE_PATH=/
